
units metal
atom_style molecular
boundary s s s    #non-periodic

# System definition
read_restart rail_at_temp.init.restart


# set groups
group free type 1 2
group anchor type  3 4
group linearz type   5 6

# Pair Coefficients
pair_style	airebo 3.0 1 0
pair_coeff * * CH.airebo C H C H C H

# add the MD part
fix nve all nve
timestep 0.00025 #picoseconds/step = 1E-12 seconds

# free atoms at 200K
fix thermo_free free temp/berendsen 200. 200. 0.25

#anchor anchors
fix anchorfix anchor setforce 0.0 0.0 0.0 #first is ID = user-assigned name for the fix,  ID of the group of atoms
velocity anchor set 0.0 0.0 0.0

#translate linearz group
fix translate_rail_fix linearz move linear 0 0 -10.0

#output
dump HCB_traj all atom 4 dump_rail.lammpstrj
thermo 10
run 100000 
